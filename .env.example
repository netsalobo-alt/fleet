# ==============================================================================
# FLEET TELECOM - MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# AVISO: Nunca comite arquivos .env com senhas reais ou tokens de produção.
# A imagem Docker é construída localmente no servidor: fleet-app:1.0.0
# Em produção Swarm, utilize Docker Secrets para senhas e chaves sensíveis.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações da Aplicação (fleet_app)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
TZ=America/Belem

# URL do frontend público roteado pelo Traefik
APP_URL=https://fleet.nortetelecom.net.br

# ------------------------------------------------------------------------------
# 2. Conexão PostgreSQL Dedicado (Rede Interna fleet_internal)
# Obs: Em produção Swarm, a senha NÃO é passada via texto puro nesta variável,
# mas sim montada via Docker Secret no caminho /run/secrets/db_password.
# ------------------------------------------------------------------------------
DB_HOST=fleet_db
DB_PORT=5432
DB_NAME=fleet_db
DB_USER=fleet_user
# DB_PASSWORD_FILE=/run/secrets/db_password
# Ou alternativamente DATABASE_URL completa (apenas no backend):
# DATABASE_URL=postgresql://fleet_user:SENHA_AQUI@fleet_db:5432/fleet_db

# ------------------------------------------------------------------------------
# 3. Chaves de Inteligência Artificial e Integrações de Apoio
# Em produção, configure o segredo no Swarm: gemini_api_key
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=AIzaSy... (Carregada via Docker Secret: gemini_api_key)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Integração de Transição (Supabase & Chatwoot)
# Mantidas durante a transição da Fase 1 para a Fase 5
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
CHATWOOT_API_URL=https://chatwoot.nortetelecom.net.br
CHATWOOT_API_TOKEN=
CHATWOOT_INBOX_ID=
